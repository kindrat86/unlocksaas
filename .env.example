# Copy this file to .env.development.local and fill in real values.
#
# Why .env.development.local instead of .env.local?
#   When you later run `vercel env pull .env.local` to fetch Vercel secrets,
#   it OVERWRITES .env.local — wiping any custom vars you put there.
#   Vars in .env.development.local survive `vercel env pull` and are still
#   loaded by Next.js dev + by our infra scripts.
#
# Both .env.local and .env.*.local are gitignored — never commit them.

# ── Namecheap API (for scripts/namecheap-dns.py) ──────────────────────────────
# Enable API access at: https://ap.www.namecheap.com/settings/tools/apiaccess/
# Then click "Manage" → toggle "API Access" ON → generate an API key.
NAMECHEAP_API_USER=your-namecheap-username
NAMECHEAP_API_KEY=paste-the-long-key-here
NAMECHEAP_USERNAME=your-namecheap-username

# IPv4 address that will call the Namecheap API.
# Must be added to the "Whitelisted IPs" list on the same API Access page.
# Check yours anytime with:  curl -4 ifconfig.me
NAMECHEAP_CLIENT_IP=85.73.94.176

# The domain whose DNS we manage from this repo.
NAMECHEAP_DOMAIN=unlocksaas.com

# ── Private Email IMAP/SMTP (for scripts/mail.py) ─────────────────────────────
# Populated by scripts/setup-mail-creds.py — DO NOT type your password directly
# into this file. Run the setup script which uses getpass() (hidden input).
MAIL_ADDRESS=maryan@unlocksaas.com
MAIL_PASSWORD=set-by-setup-mail-creds.py
MAIL_IMAP_HOST=mail.privateemail.com
MAIL_IMAP_PORT=993
MAIL_SMTP_HOST=mail.privateemail.com
MAIL_SMTP_PORT=587

# ── Supabase (DB + Auth) ──────────────────────────────────────────────────────
# Project provisioned via the Supabase MCP (or manually at supabase.com/dashboard).
# Publishable / anon keys are safe to expose to the client.
# Service role + Postgres URLs come from the dashboard:
#   https://supabase.com/dashboard/project/<project-ref>/settings/api
#   https://supabase.com/dashboard/project/<project-ref>/settings/database
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ-legacy-anon-jwt-xxxxxxxxxxxxxxxxxxxxxxxx

# Server-only. NEVER expose to client. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=eyJ-service-role-jwt-xxxxxxxxxxxxxxxxxxxxxxxx

# Pooled Postgres URLs (port 6543 = transaction pooler for serverless, 5432 = session pooler for migrations).
DATABASE_URL=postgres://postgres.your-project-ref:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
POSTGRES_URL_NON_POOLING=postgres://postgres.your-project-ref:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# ── Resend (transactional email — receipts, magic links, password resets) ────
# Generate at: https://resend.com/api-keys  (Permission: "Full access", Domain: "All domains")
# The "Full access" permission is required so scripts/namecheap-dns.py add-resend
# can fetch the domain's DNS records via GET /domains/<id>. A send-only key
# would let you send mail but block domain provisioning.
# Domain is provisioned in region eu-west-1 (matches gitdealflow.com pattern).
# Populated by scripts/setup-resend-key.py — uses getpass() + paste validation.
# NEVER use `echo` or zsh `read -s -p` — both leak the key to shell history.
RESEND_API_KEY=set-by-setup-resend-key.py

# ── Stripe (LIVE keys for $1 Starter OTO + $49/mo Core) ──────────────────────
# Populated by scripts/setup-stripe-keys.py — uses getpass() + prefix validation
# + paste anti-pattern detection (strips embedded shell prefixes, surrounding
# quotes, env-var prefix). NEVER enter Stripe keys any other way — `echo`,
# `read -s -p`, or direct editor paste all leak to scrollback / ~/.zsh_history.
# Keys at: https://dashboard.stripe.com/apikeys
# To rotate after exposure: roll the secret in dashboard, then re-run setup
# script with `--only secret_key`.
STRIPE_SECRET_KEY=set-by-setup-stripe-keys.py
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=set-by-setup-stripe-keys.py

# ── Cron auth (Vercel Crons) ─────────────────────────────────────────────────
# When set, Vercel injects `Authorization: Bearer $CRON_SECRET` on every
# cron-triggered request. The /api/cron/* handlers verify the header before
# touching state. If unset, the handlers run without auth — DO NOT ship to
# production without this set.
# Generate any 32+ byte random string and push via:
#   vercel env add CRON_SECRET production
CRON_SECRET=set-a-long-random-string-for-production

# ── Unsubscribe HMAC signing key (optional but preferred) ────────────────────
# Used by /api/unsubscribe to verify one-click unsubscribe tokens. Falls back
# to SUPABASE_SERVICE_ROLE_KEY when unset — but rotating that key would
# invalidate every outstanding unsubscribe link in flight, so for a clean
# rotation story set this explicitly.
UNSUBSCRIBE_SECRET=set-a-long-random-string-different-from-cron-secret

# ── Stripe Connect (user-account OAuth, read-only) ───────────────────────────
# The /onboarding flow's third card lets the customer connect THEIR Stripe
# account so /api/stripe-connect/callback can detect their first paying
# customer (writes to public.verified_conversions, feeding the 60-day
# guarantee verifier in lib/guarantee.ts).
#
# How to set up:
#   1. https://dashboard.stripe.com/settings/connect → Activate Standard
#   2. Add redirect URIs:
#        https://unlocksaas.com/api/stripe-connect/callback         (prod)
#        http://localhost:3000/api/stripe-connect/callback          (dev)
#   3. Copy the `ca_*` client id below.
#
# Public client id (it sits in the OAuth authorize URL), but set server-side
# so test/live can swap without a redeploy.
STRIPE_CONNECT_CLIENT_ID=ca_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# HMAC secret for the Connect OAuth state token (CSRF + replay protection).
# Falls back to SUPABASE_SERVICE_ROLE_KEY when unset — set this explicitly so
# rotating one secret doesn't invalidate in-flight Connect flows.
# Generate with: openssl rand -hex 32
STRIPE_CONNECT_STATE_SECRET=set-a-long-random-hex-string

# ── PostHog (product analytics → brunson-funnel-metrics) ─────────────────────
# Feeds the funnel-performance dashboards the brunson-funnel-metrics skill
# reads. Public write key + host are safe to expose to the browser (they
# auth event capture, not data access). The personal API key (for export /
# query endpoints) is sensitive and is NOT used by the app — only by tooling.
#
# Provisioning:
#   1. Sign up at https://posthog.com (EU Cloud recommended — Maryan is EU).
#   2. Create a project named "UnlockSaaS".
#   3. Settings → Project API Keys → copy the project API key (phc_...).
#   4. Settings → API Host → copy the regional URL (https://eu.i.posthog.com
#      for EU, https://us.i.posthog.com for US). Use the *ingestion* host,
#      not the dashboard URL.
#   5. Populate via:    python3 scripts/setup-posthog-key.py
#      (the script writes both vars and validates the phc_ prefix).
#   6. Push to Vercel (NEXT_PUBLIC_* are public, no --sensitive needed):
#        vercel env add NEXT_PUBLIC_POSTHOG_KEY production
#        vercel env add NEXT_PUBLIC_POSTHOG_HOST production
#      (repeat for preview + development envs)
#
# Event taxonomy lives in app/src/lib/analytics/events.ts. The Stripe
# webhook is the source of truth for conversions (PostHog mirror is for
# joinability with click data).
NEXT_PUBLIC_POSTHOG_KEY=set-by-setup-posthog-key.py
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ── Video shoot — VSL + 3 Founding PLVs (Brunson Building Block #20) ─────────
# All four video surfaces are designed to read from one canonical host: Mux.
# `scripts/upload-shoot.py` uploads a recorded MP4, captures the Mux playback
# ID, and pushes the env var(s) below to Vercel (prod + preview + dev). When
# the env vars are unset, every page renders a Brunson-correct fallback (the
# kinetic-typography scripted VSL on `/` and `/machine-sales`; a "video
# upload pending" placeholder on `/founding`'s three PLV slots) — the funnel
# is never broken pre-shoot.
#
# Operator one-pager: strategy/OPERATOR-SHOOT-DAY.md
#
# Recording scripts:
#   - VSL: strategy/founder-vsl-script.md (3–5 min)
#   - PLV1/2/3: strategy/founding-plv-scripts.md (5–7, 8–10, 10–12 min)
#
# Pre-shoot, run:   python3 scripts/setup-mux-credentials.py
# Post-shoot, run:  python3 scripts/upload-shoot.py <path-to-mp4> <ENV_VAR_NAME>
#
# VSL — the full 4–5 min founder VSL on `/machine-sales` and the funnel hub.
# The VSL player accepts any URL <video src> understands (MP4 / HLS). Mux's
# static MP4 rendition URL is `https://stream.mux.com/<PLAYBACK_ID>/medium.mp4`.
# The upload script writes the full URL here, not just the playback ID,
# because the VSL block was wired to NEXT_PUBLIC_VSL_URL before Founding
# standardized on the playback-ID convention. Same Mux asset, just a
# different surface contract.
NEXT_PUBLIC_VSL_URL=
NEXT_PUBLIC_VSL_POSTER_URL=

# Founding-Cohort PLVs — three pre-launch videos on `/founding`. The
# `/founding` page reads these server-side, composes the Mux MP4 URL inline,
# and renders a native <video>. NOT public (no NEXT_PUBLIC_ prefix) — the
# playback ID never lands in the client bundle until composed inside the
# server component.
#
# Each variable holds a RAW Mux playback ID (e.g. `Lxa9eCXLi9LmlSdgVZA01u`),
# NOT a URL. The upload script (scripts/upload-shoot.py) emits the raw ID
# for these three vars and the full URL for NEXT_PUBLIC_VSL_URL above.
FOUNDING_PLV1_PLAYBACK=
FOUNDING_PLV2_PLAYBACK=
FOUNDING_PLV3_PLAYBACK=

# Mux API credentials — used ONLY by scripts/upload-shoot.py for upload.
# NOT consumed at runtime by any page or API route. Live in
# .env.development.local; do NOT push to Vercel. Rotate at the Mux dashboard
# (Settings → Access Tokens) — System tokens with `Mux Video > Write`
# permission are sufficient.
#
# Set via:  python3 scripts/setup-mux-credentials.py
MUX_TOKEN_ID=set-by-setup-mux-credentials.py
MUX_TOKEN_SECRET=set-by-setup-mux-credentials.py

# Off-platform entity anchors – Organization.sameAs + Person.sameAs (E-E-A-T).
#
# These flip the schema.org `sameAs` arrays on the Organization and Person
# JSON-LD blocks (rendered on `/` and `/about`). Each var holds ONE absolute
# https:// URL pointing at a real, public, operator-controlled profile that
# bidirectionally identifies Maryan / Unlock SaaS – the linked profile's bio
# must name unlocksaas.com for Google's Knowledge Graph to award full
# confidence on the round-trip. One-way sameAs entries still parse, but earn
# a lower confidence weight than profiles that claim the site back.
#
# Validation lives in src/lib/seo/entity.ts (readSocialEnv):
#   - https:// only (http rejected to avoid downgrade-looking fabrications)
#   - must pass the URL constructor
#   - empty / whitespace / malformed values are silently dropped
#   - duplicates collapsed defensively (in case the same URL lands twice)
#
# Brunson Hard-Rule: leave a var unset until the profile actually exists.
# The empty default is the honest signal – no off-platform anchors claimed.
#
# Suggested fill order, by GEO / AIO impact per effort:
#   1. NEXT_PUBLIC_UNLOCKSAAS_X_URL              (Twitter / X)
#   2. NEXT_PUBLIC_UNLOCKSAAS_INDIE_HACKERS_URL  (Indie Hackers)
#   3. NEXT_PUBLIC_UNLOCKSAAS_LINKEDIN_URL       (LinkedIn personal)
#   4. NEXT_PUBLIC_UNLOCKSAAS_GITHUB_URL         (GitHub)
#   5. NEXT_PUBLIC_UNLOCKSAAS_YOUTUBE_URL        (YouTube channel)
#   6. NEXT_PUBLIC_UNLOCKSAAS_CRUNCHBASE_URL     (Crunchbase company page)
#   7. NEXT_PUBLIC_UNLOCKSAAS_PRODUCT_HUNT_URL   (Product Hunt maker / product)
#   8. NEXT_PUBLIC_UNLOCKSAAS_OTHER_URL          (Wikidata Q-number or ad-hoc)
#
# NEXT_PUBLIC_ prefix is required: these are public URLs surfaced in the
# server-rendered Organization block. None are sensitive.
#
# Set on Vercel via:
#   vercel env add NEXT_PUBLIC_UNLOCKSAAS_X_URL production preview
# then redeploy. Local: drop the value below into .env.development.local
# (NOT .env.local – `vercel env pull` overwrites that file).
NEXT_PUBLIC_UNLOCKSAAS_X_URL=
NEXT_PUBLIC_UNLOCKSAAS_INDIE_HACKERS_URL=
NEXT_PUBLIC_UNLOCKSAAS_LINKEDIN_URL=
NEXT_PUBLIC_UNLOCKSAAS_GITHUB_URL=
NEXT_PUBLIC_UNLOCKSAAS_YOUTUBE_URL=
NEXT_PUBLIC_UNLOCKSAAS_CRUNCHBASE_URL=
NEXT_PUBLIC_UNLOCKSAAS_PRODUCT_HUNT_URL=
NEXT_PUBLIC_UNLOCKSAAS_OTHER_URL=
