# Copy this file to .env.development.local and fill in real values.
#
# Why .env.development.local instead of .env.local?
#   When you later run `vercel env pull .env.local` to fetch Vercel secrets,
#   it OVERWRITES .env.local — wiping any custom vars you put there.
#   Vars in .env.development.local survive `vercel env pull` and are still
#   loaded by Next.js dev + by our infra scripts.
#
# Both .env.local and .env.*.local are gitignored — never commit them.

# ── Namecheap API (for scripts/namecheap-dns.py) ──────────────────────────────
# Enable API access at: https://ap.www.namecheap.com/settings/tools/apiaccess/
# Then click "Manage" → toggle "API Access" ON → generate an API key.
NAMECHEAP_API_USER=your-namecheap-username
NAMECHEAP_API_KEY=paste-the-long-key-here
NAMECHEAP_USERNAME=your-namecheap-username

# IPv4 address that will call the Namecheap API.
# Must be added to the "Whitelisted IPs" list on the same API Access page.
# Check yours anytime with:  curl -4 ifconfig.me
NAMECHEAP_CLIENT_IP=85.73.94.176

# The domain whose DNS we manage from this repo.
NAMECHEAP_DOMAIN=unlocksaas.com

# ── Private Email IMAP/SMTP (for scripts/mail.py) ─────────────────────────────
# Populated by scripts/setup-mail-creds.py — DO NOT type your password directly
# into this file. Run the setup script which uses getpass() (hidden input).
MAIL_ADDRESS=maryan@unlocksaas.com
MAIL_PASSWORD=set-by-setup-mail-creds.py
MAIL_IMAP_HOST=mail.privateemail.com
MAIL_IMAP_PORT=993
MAIL_SMTP_HOST=mail.privateemail.com
MAIL_SMTP_PORT=587

# ── Supabase (DB + Auth) ──────────────────────────────────────────────────────
# Project provisioned via the Supabase MCP (or manually at supabase.com/dashboard).
# Publishable / anon keys are safe to expose to the client.
# Service role + Postgres URLs come from the dashboard:
#   https://supabase.com/dashboard/project/<project-ref>/settings/api
#   https://supabase.com/dashboard/project/<project-ref>/settings/database
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ-legacy-anon-jwt-xxxxxxxxxxxxxxxxxxxxxxxx

# Server-only. NEVER expose to client. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=eyJ-service-role-jwt-xxxxxxxxxxxxxxxxxxxxxxxx

# Pooled Postgres URLs (port 6543 = transaction pooler for serverless, 5432 = session pooler for migrations).
DATABASE_URL=postgres://postgres.your-project-ref:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
POSTGRES_URL_NON_POOLING=postgres://postgres.your-project-ref:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# ── Resend (transactional email — receipts, magic links, password resets) ────
# Generate at: https://resend.com/api-keys  (Permission: "Full access", Domain: "All domains")
# The "Full access" permission is required so scripts/namecheap-dns.py add-resend
# can fetch the domain's DNS records via GET /domains/<id>. A send-only key
# would let you send mail but block domain provisioning.
# Domain is provisioned in region eu-west-1 (matches gitdealflow.com pattern).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
