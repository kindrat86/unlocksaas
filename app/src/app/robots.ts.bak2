import type { MetadataRoute } from "next";

export default function robots(): MetadataRoute.Robots {
  return {
    rules: {
      userAgent: "*",
      allow: "/",
      disallow: ["/api/auth/", "/api/webhook/", "/api/cron/", "/dashboard/", "/account/", "/login/"],
    },
    sitemap: "https://unlocksaas.com/sitemap.xml",
  };
}
