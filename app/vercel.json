{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/mcp.html"
    },
    {
      "source": "/related-tools",
      "destination": "/related-tools.html"
    }
  ],
  "redirects": [
    {
      "source": "/parables",
      "destination": "/stories",
      "permanent": true
    },
    {
      "source": "/parables.md",
      "destination": "/stories.md",
      "permanent": true
    },
    {
      "source": "/AGENTS.md",
      "destination": "/.well-known/agents.md",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/indexnow",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/gsc-feedback",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/recrawl",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/llmo-citations",
      "schedule": "0 9 * * 1"
    }
  ],
  "headers": [
    {
      "source": "/embed/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; frame-ancestors *"
        },
        {
          "key": "X-Frame-Options",
          "value": "ALLOWALL"
        }
      ]
    },
    {
      "source": "/network/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; frame-ancestors *"
        },
        {
          "key": "X-Frame-Options",
          "value": "ALLOWALL"
        }
      ]
    },
    {
      "source": "/widgets/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; frame-ancestors *"
        },
        {
          "key": "X-Frame-Options",
          "value": "ALLOWALL"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(glossary|tools|benchmarks|faq|stories|case-studies|who|dream-100|community-atlas|hso|ad-library|launch-checklist|mistakes|how-to|alternatives-to|vs|funnel-teardown|pricing-teardown|answers|swipe-files|stacks|get-.+|llms\\.txt|llms-full\\.txt|state-of-saas|apply|bridge|challenge|repeatable)(/.*)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}