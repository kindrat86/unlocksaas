{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/parables", "destination": "/stories", "permanent": true },
    { "source": "/parables.md", "destination": "/stories.md", "permanent": true }
  ],
  "crons": [
    {
      "path": "/api/cron/activate-funnelfixer-carryover",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/funnelfixer-tick",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/testimonial-farm-offer",
      "schedule": "25,55 * * * *"
    },
    {
      "path": "/api/cron/soap-opera",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/seinfeld",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/founding",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/cart-recovery",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/indexnow",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/gsc-feedback",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/teardown-courtesy",
      "schedule": "0 13 * * 1-5"
    }
  ]
}
