# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_STARTER_PRICE_ID=price_xxx
STRIPE_MACHINE_PRICE_ID=price_xxx

# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxx

# Resend
RESEND_API_KEY=re_xxx

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# VSL — Brunson Building Block #20 (Video Sales Letter).
# When unset, the player renders the kinetic-typography scripted fallback
# from app/src/lib/vsl/script.ts. When set to any URL <video> can play
# (Cloudflare Stream HLS, Mux, direct MP4, S3), the player switches to
# real video automatically on next page load. No code change required.
# Both vars are NEXT_PUBLIC because the <video src> renders client-side —
# do NOT put secrets here.
# Push to Vercel via:
#   vercel env add NEXT_PUBLIC_VSL_URL production preview development
#   vercel env add NEXT_PUBLIC_VSL_POSTER_URL production preview development
NEXT_PUBLIC_VSL_URL=
NEXT_PUBLIC_VSL_POSTER_URL=

# Founding-Cohort PLF (workbook 03 Script 8, revised 2026-05-17)
# ISO 8601 timestamps. Cart is OPEN between these. Before open: waitlist mode.
# After close OR after 50 seats claimed: door-closed mode. Push via:
#   vercel env add FOUNDING_CART_OPEN_AT production
#   vercel env add FOUNDING_CART_CLOSE_AT production
# Both optional — when unset, /founding renders in pre-launch waitlist mode
# (the safe default state).
FOUNDING_CART_OPEN_AT=
FOUNDING_CART_CLOSE_AT=

# Mux / Cloudflare Stream playback IDs for the three PLVs (see
# strategy/founding-plv-scripts.md). Until set, /founding renders placeholder
# blocks per video.
FOUNDING_PLV1_PLAYBACK=
FOUNDING_PLV2_PLAYBACK=
FOUNDING_PLV3_PLAYBACK=
