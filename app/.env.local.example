# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_STARTER_PRICE_ID=price_xxx
STRIPE_MACHINE_PRICE_ID=price_xxx

# Anthropic (direct -- used as fallback when AI_GATEWAY_API_KEY is absent)
ANTHROPIC_API_KEY=sk-ant-xxx

# Vercel AI Gateway -- routes all LLM calls through the gateway for token
# observability, unified billing, and provider failover. When set, takes
# precedence over ANTHROPIC_API_KEY. Generate a key at:
#   https://vercel.com/[team]/~/ai-gateway/api-keys
# Push to Vercel via:
#   vercel env add AI_GATEWAY_API_KEY production preview development
# Model strings become "anthropic/claude-sonnet-4-6" (gateway format).
# When unset, the app falls back to direct Anthropic -- no code change needed.
AI_GATEWAY_API_KEY=

# Verified Builders community gate (Isenberg overlay: community is the new moat).
# When set to a valid URL, the Stripe webhook emails this link to every new Core
# subscriber and the /onboarding "Step into the Verified Builders room" card
# unlocks with an Open button. Platform (Skool vs Discord) is auto-detected
# from the host for in-app copy – no code change needed to switch later.
#
# Set in Vercel via:
#   vercel env add COMMUNITY_INVITE_URL production
#   vercel env add COMMUNITY_INVITE_URL development
# (CLI bug: vercel env add preview is broken in CLI 54.2.0 – use the Vercel
# dashboard or the REST API POST /v10/projects/{id}/env for the preview target.
# See memory: feedback_vercel_cli_preview_env_bug.md)
#
# Until set, the onboarding card renders "the room is opening shortly" and the
# Stripe webhook records the grant audit row without sending an invite email –
# safe to deploy code first, paste URL second.
COMMUNITY_INVITE_URL=

# Resend
RESEND_API_KEY=re_xxx

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# VSL — Brunson Building Block #20 (Video Sales Letter).
# When unset, the player renders the kinetic-typography scripted fallback
# from app/src/lib/vsl/script.ts. When set to any URL <video> can play
# (Cloudflare Stream HLS, Mux, direct MP4, S3), the player switches to
# real video automatically on next page load. No code change required.
# Both vars are NEXT_PUBLIC because the <video src> renders client-side —
# do NOT put secrets here.
# Push to Vercel via:
#   vercel env add NEXT_PUBLIC_VSL_URL production preview development
#   vercel env add NEXT_PUBLIC_VSL_POSTER_URL production preview development
NEXT_PUBLIC_VSL_URL=
NEXT_PUBLIC_VSL_POSTER_URL=

# Founding-Cohort PLF (workbook 03 Script 8, revised 2026-05-17)
# ISO 8601 timestamps. Cart is OPEN between these. Before open: waitlist mode.
# After close OR after 50 seats claimed: door-closed mode. Push via:
#   vercel env add FOUNDING_CART_OPEN_AT production
#   vercel env add FOUNDING_CART_CLOSE_AT production
# Both optional — when unset, /founding renders in pre-launch waitlist mode
# (the safe default state).
FOUNDING_CART_OPEN_AT=
FOUNDING_CART_CLOSE_AT=

# Mux / Cloudflare Stream playback IDs for the three PLVs (see
# strategy/founding-plv-scripts.md). Until set, /founding renders placeholder
# blocks per video.
FOUNDING_PLV1_PLAYBACK=
FOUNDING_PLV2_PLAYBACK=
FOUNDING_PLV3_PLAYBACK=

# Organization (Unlock SaaS) JSON-LD entity-graph anchors.
# Read at build time by src/lib/seo/entity.ts; consumed by the canonical
# Organization JSON-LD in src/components/seo/json-ld.tsx and the
# /.well-known/entity.jsonld manifest. Same Brunson Hard-Rule: each slot
# stays empty until a real, round-trip-claimed off-platform anchor exists.
#
# Knowledge-Graph anchors – strongest GEO/AIO multipliers.
# Wikidata Q-URL flows through:
#   - ORGANIZATION_SAME_AS         (Organization.sameAs row)
#   - ORGANIZATION_WIKIDATA_QID    (Organization.identifier[] PropertyValue
#                                   with propertyID="wikidata" – the bare
#                                   Q-ID form KG resolves without URL
#                                   parsing; e.g. "Q139863921")
# Wikipedia URL flows through:
#   - ORGANIZATION_SAME_AS         (Organization.sameAs row)
#   - ORGANIZATION_MAIN_ENTITY_OF_PAGE (Organization.mainEntityOfPage –
#                                       one-to-one authoritative external
#                                       description, stronger weight than
#                                       a sameAs row alone)
# See strategy/wikidata-application/README.md for the operator activation
# runbook. Push to Vercel via:
#   vercel env add NEXT_PUBLIC_UNLOCKSAAS_WIKIDATA_URL production preview
#   vercel env add NEXT_PUBLIC_UNLOCKSAAS_WIKIPEDIA_URL production preview
NEXT_PUBLIC_UNLOCKSAAS_WIKIDATA_URL=
NEXT_PUBLIC_UNLOCKSAAS_WIKIPEDIA_URL=

# Organization social / company-registry anchors. Each flows into
# Organization.sameAs via src/lib/seo/entity.ts buildSameAs(). Each value
# must be an absolute https URL pointing at a profile / listing whose bio
# names unlocksaas.com (bidirectional claim, the strongest KG signal).
# OpenCorporates + Wellfound (formerly AngelList) are company-registry
# anchors and weigh heavier than generic socials.
NEXT_PUBLIC_UNLOCKSAAS_X_URL=
NEXT_PUBLIC_UNLOCKSAAS_LINKEDIN_URL=
NEXT_PUBLIC_UNLOCKSAAS_GITHUB_URL=
NEXT_PUBLIC_UNLOCKSAAS_INDIE_HACKERS_URL=
NEXT_PUBLIC_UNLOCKSAAS_PRODUCT_HUNT_URL=
NEXT_PUBLIC_UNLOCKSAAS_CRUNCHBASE_URL=
NEXT_PUBLIC_UNLOCKSAAS_OPENCORPORATES_URL=
NEXT_PUBLIC_UNLOCKSAAS_WELLFOUND_URL=
NEXT_PUBLIC_UNLOCKSAAS_YOUTUBE_URL=
NEXT_PUBLIC_UNLOCKSAAS_OTHER_URL=

# Founder (Person) JSON-LD enrichment slots.
# Read at build time by src/lib/seo/founder.ts; consumed by Person JSON-LD
# in src/components/seo/json-ld.tsx. Brunson Hard-Rule: every slot stays
# empty until a real, round-trip-claimed profile exists. An unset env
# omits the schema key entirely – no fabricated identity ships.
#
# Founder Knowledge-Graph anchors – strongest GEO/AIO multipliers in the
# Person sameAs array. Each entity (Organization, Founder) gets its own
# Q-item once notable; do NOT reuse the Organization's Wikidata Q-URL
# (NEXT_PUBLIC_UNLOCKSAAS_WIKIDATA_URL) here – that's the Org's anchor,
# not the Person's. Stays empty until the Founder passes Wikidata
# notability (typically: founder of a notable company, two non-trivial
# secondary sources, or authorship of a notable work).
#
# When activated, both URLs flow through:
#   - src/lib/seo/founder.ts → FOUNDER_SAME_AS (Person.sameAs row)
#   - src/lib/seo/founder.ts → FOUNDER_WIKIDATA_QID (Person.identifier[]
#     PropertyValue with propertyID="wikidata" – the bare Q-ID form KG
#     resolves without URL parsing).
#
# Push to Vercel via:
#   vercel env add NEXT_PUBLIC_FOUNDER_WIKIDATA_URL production preview
#   vercel env add NEXT_PUBLIC_FOUNDER_WIKIPEDIA_URL production preview
NEXT_PUBLIC_FOUNDER_WIKIDATA_URL=
NEXT_PUBLIC_FOUNDER_WIKIPEDIA_URL=

# Per-platform sameAs slots. Each value must be an absolute https URL
# pointing at a profile whose bio names unlocksaas.com (bidirectional
# claim – see strategy/sameas-activation-playbook.md). Push to Vercel via:
#   vercel env add NEXT_PUBLIC_FOUNDER_SAMEAS_<PLATFORM> production preview
NEXT_PUBLIC_FOUNDER_SAMEAS_LINKEDIN=
NEXT_PUBLIC_FOUNDER_SAMEAS_TWITTER=
NEXT_PUBLIC_FOUNDER_SAMEAS_GITHUB=
NEXT_PUBLIC_FOUNDER_SAMEAS_CRUNCHBASE=
NEXT_PUBLIC_FOUNDER_SAMEAS_PRODUCT_HUNT=
NEXT_PUBLIC_FOUNDER_SAMEAS_ANGELLIST=

# alumniOf / award – comma-separated lists. Each entry becomes a Person
# field in the JSON-LD. Empty values are omitted; only set when the
# institution / award actually exists and the founder can substantiate it.
#   NEXT_PUBLIC_FOUNDER_ALUMNI_OF="Acme University, Bravo Bootcamp"
#   NEXT_PUBLIC_FOUNDER_AWARDS="Indie Hackers Featured Maker 2025"
NEXT_PUBLIC_FOUNDER_ALUMNI_OF=
NEXT_PUBLIC_FOUNDER_AWARDS=

# Dataset DOI - Zenodo cross-listing (strategy/dataset-submission-playbook.md).
# Activated by scripts/mint-zenodo-deposit.py after the deposit publishes.
# Both vars are NEXT_PUBLIC because the values render into server-rendered
# JSON-LD / BibTeX / citation - no secrecy contract.
#
# Push to Vercel via:
#   vercel env add NEXT_PUBLIC_UNLOCKSAAS_ZENODO_DOI production
#   vercel env add NEXT_PUBLIC_UNLOCKSAAS_ZENODO_DOI_URL production
#
# Until set, the canonical Dataset JSON-LD does not advertise a DOI -
# honest zero-state (Brunson Hard-Rule). The moment both vars resolve,
# the DOI propagates into Dataset.identifier (PropertyValue), the BibTeX
# doi field, the citation string, and the HF dataset card YAML.
NEXT_PUBLIC_UNLOCKSAAS_ZENODO_DOI=
NEXT_PUBLIC_UNLOCKSAAS_ZENODO_DOI_URL=

# OSF.io secondary DOI mirror (optional, additive to Zenodo). Same
# semantics: bare DOI in one var, record URL in the other. Submission
# is via OSF web UI (no API parallel to the Zenodo CLI yet).
NEXT_PUBLIC_UNLOCKSAAS_OSF_DOI=
NEXT_PUBLIC_UNLOCKSAAS_OSF_DATASET_URL=

# Founder ORCID iD (optional). When set, the Zenodo deposition payload
# carries the ORCID on the creator block so the deposit landing page
# renders a clickable ORCID badge and the citation export formats
# include it. Format: 0000-0000-0000-0000 (16 digits in 4 groups).
NEXT_PUBLIC_UNLOCKSAAS_FOUNDER_ORCID=

# Zenodo API token (operator secret, NOT exposed to the client). Only
# used by scripts/mint-zenodo-deposit.py. Generate at
# https://zenodo.org/account/settings/applications/ with scopes
# deposit:write + deposit:actions. Do NOT push this to Vercel - it
# stays in the operator environment.
ZENODO_API_TOKEN=

# /numbers public metrics transparency page.
# Set to 'true' to show the page publicly. Leave unset (or any other value)
# to show a "coming soon" placeholder instead. The URL is always accessible.
# Operator workflow: edit app/data/public-metrics.json, git commit, git push,
# then set this to 'true' in Vercel when week-1 data is ready to publish.
# Push to Vercel via:
#   vercel env add NEXT_PUBLIC_NUMBERS_VISIBLE production
NEXT_PUBLIC_NUMBERS_VISIBLE=
